# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOT VITE_-prefixed: this key must never be bundled by Vite. Read only by
# scripts/*.cjs and api/*.ts (Vercel serverless functions), never by src/.
SUPABASE_SERVICE_ROLE_KEY=

# Application Configuration
VITE_APP_NAME="PHILZ SIGNATURE"
VITE_APP_TAGLINE="Your scent. Your signature."
VITE_APP_URL=http://localhost

# Email (Resend) — used as a fallback when no admin-configured SMTP settings exist
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Philz Signature <orders@philzsignature.com>"

# Symmetric key used to encrypt admin-configured SMTP passwords at rest (AES-256-GCM).
# Server-side only — never prefix with VITE_. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
